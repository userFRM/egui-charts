---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { areas, counts, features, percentage, slug } from '../../lib/progress';

const repo = 'https://github.com/userFRM/egui-charts/blob/main';
const tables = areas.map((area) => {
  const rows = features.filter((row) => row.area === area);
  const groups = [...new Set(rows.map((row) => row.group))].map((name) => {
    const members = rows.filter((row) => row.group === name);
    const done = counts(members).done;
    return { name, done, total: members.length, share: Math.round(done / members.length * 100) };
  });
  return { area, groups, done: counts(rows).done, total: rows.length, share: percentage(rows) };
});
---
<StarlightPage
  frontmatter={{ title: 'Progress', description: 'Feature status and remaining gaps in egui-charts.', editUrl: false }}
  headings={areas.map((area) => ({ depth: 2, slug: slug(area), text: area }))}
>
<img src="progress.svg" alt="Feature map grouped by area: green is done, yellow is partial and grey is missing.">
<p>Generated from <a href={`${repo}/docs/progress/features.csv`}>docs/progress/features.csv</a> by <a href={`${repo}/docs/site/src/lib/progress-svg.ts`}>docs/site/src/lib/progress-svg.ts</a> on every push to <code>main</code>.</p>
<p>In the map, green features are done, yellow ones partial and grey ones missing. A feature is done when its whole behaviour works; partial and missing features count as not done. A host feature is done when the library provides its interface and UI; the application supplies the data, account or storage behind it. <a href={`${repo}/CONTRIBUTING.md#feature-status`}>Counting rules</a>.</p>
{tables.map((table) => (
  <Fragment>
    <h2 id={slug(table.area)}>{table.area}</h2>
    <table>
      <tr><th>Group</th><th>Done</th><th>Total</th><th>%</th></tr>
      {table.groups.map((group) => <tr><td>{group.name}</td><td>{group.done}</td><td>{group.total}</td><td>{group.share}%</td></tr>)}
      <tr><th>Total</th><th>{table.done}</th><th>{table.total}</th><th>{table.share}%</th></tr>
    </table>
  </Fragment>
))}
</StarlightPage>

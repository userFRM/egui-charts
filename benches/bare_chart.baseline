# Figures the `bare-chart` job in .github/workflows/ci.yml checks: the stripped size of
# examples/bare_chart.rs and the instructions per frame of benches/bare_chart.rs, both built
# with `--no-default-features --features widget` by the MSRV toolchain on ubuntu-24.04.
# The job fails when a figure grows beyond its tolerance. A pull request that accepts the growth
# commits the values its job summary prints and says why.
size_bytes=13991422
frame_instructions=8000013
